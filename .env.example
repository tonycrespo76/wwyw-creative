# Copy to .env.local. Never commit real values.
SPIKE_SECRET=
MEDIA_ROOT=

# Cloudflare Turnstile. For local development Cloudflare publishes always-pass test keys:
# site key 1x00000000000000000000AA, secret key 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
